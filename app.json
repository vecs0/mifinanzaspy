{
  "expo": {
    "name": "MiFinanzasPY",
    "slug": "mifinanzaspy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mifinanzaspy",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mifinanzaspy.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "La app puede usar la cámara para escanear comprobantes.",
        "NSPhotoLibraryUsageDescription": "La app puede acceder a imágenes para importar comprobantes.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.mifinanzaspy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "backgroundColor": "#FAF8F4",
        "imageWidth": 280,
        "resizeMode": "contain"
      },
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/be4592b1-3f74-4649-9782-2f8bd460f8b1"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportedBanks": [
        "itau",
        "continental",
        "gnb",
        "sudameris",
        "bnf",
        "basa",
        "atlas",
        "familiar",
        "bancop",
        "interfisa",
        "solar",
        "regional",
        "vision",
        "ueno",
        "zeta",
        "citi",
        "bna",
        "bbrasil",
        "tigo_money",
        "personal_pay",
        "pago_express"
      ],
      "router": {},
      "eas": {
        "projectId": "be4592b1-3f74-4649-9782-2f8bd460f8b1"
      }
    },
    "owner": "cabrvix"
  }
}
