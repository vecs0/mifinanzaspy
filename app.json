{
  "expo": {
    "name": "MiFinanzasPY",
    "slug": "mifinanzaspy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mifinanzaspy",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mifinanzaspy.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "La app puede usar la cámara para escanear comprobantes.",
        "NSPhotoLibraryUsageDescription": "La app puede acceder a imágenes para importar comprobantes."
      }
    },
    "android": {
      "package": "com.mifinanzaspy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "anthropicApiUrl": "https://api.anthropic.com/v1/messages",
      "supportedBanks": [
        "itau",
        "continental",
        "gnb",
        "sudameris",
        "bnf",
        "basa",
        "atlas",
        "familiar",
        "bancop",
        "interfisa",
        "solar",
        "regional",
        "vision",
        "ueno",
        "zeta",
        "citi",
        "bna",
        "bbrasil",
        "tigo_money",
        "personal_pay",
        "pago_express",
        "itau",
        "continental",
        "gnb",
        "sudameris",
        "bnf",
        "basa",
        "atlas",
