{
  "expo": {
    "name": "MiFinanzasPY",
    "slug": "mifinanzaspy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mifinanzaspy",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mifinanzaspy.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "La app puede usar la cámara para escanear comprobantes.",
        "NSPhotoLibraryUsageDescription": "La app puede acceder a imágenes para importar comprobantes.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.mifinanzaspy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1EB",
          "image": "./assets/splash-transparente.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1714",
            "image": "./assets/splash-transparente.png"
          }
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/be4592b1-3f74-4649-9782-2f8bd460f8b1"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be4592b1-3f74-4649-9782-2f8bd460f8b1"
      }
    },
    "owner": "cabrvix"
  }
}
