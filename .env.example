# Plantilla de variables de entorno de MiFinanzasPY.
# Copiala a .env.local en la raiz del repo (seccion 4 de docs/DOCUMENTACION.md).
# .env.local no se versiona; este archivo si, y nunca lleva valores reales.

# URL base del Worker proxy de Gemini (workers/gemini-proxy.js). Sin valor, la app
# muestra el asesor como "no configurado".
EXPO_PUBLIC_WORKER_URL=

# Token de app que viaja en el bundle y debe coincidir con el secret APP_TOKEN del
# Worker. Es un disuasivo no secreto, no una API key: no protege datos.
EXPO_PUBLIC_WORKER_APP_TOKEN=

# La key de Gemini (GEMINI_API_KEY) es un secret del Worker y nunca va en este archivo
# ni en ninguna variable EXPO_PUBLIC_*.
